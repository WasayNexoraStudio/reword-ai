# RewordAI configuration
# Local: copy this file to .env.
# Vercel: set these in Project Settings > Environment Variables.

# Your Gemini API key from https://aistudio.google.com/apikey
USER_LLM_API_KEY=your-gemini-api-key-here

# Gemini API base URL
USER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini model
USER_LLM_MODEL=gemini-2.0-flash

# Port the local server listens on
PORT=3000
