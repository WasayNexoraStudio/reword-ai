{
  "version": 2,
  "builds": [
    {
      "src": "api/paraphrase.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "favicon-48.png",
      "use": "@vercel/static"
    },
    {
      "src": "favicon-192.png",
      "use": "@vercel/static"
    },
    {
      "src": "favicon-512.png",
      "use": "@vercel/static"
    },
    {
      "src": "apple-touch-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "og.svg",
      "use": "@vercel/static"
    },
    {
      "src": "og.png",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "sentence-rewriter.html",
      "use": "@vercel/static"
    },
    {
      "src": "paraphrase-essay.html",
      "use": "@vercel/static"
    },
    {
      "src": "how-to-paraphrase.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/paraphrase",
      "dest": "/api/paraphrase.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/favicon-48.png",
      "dest": "/favicon-48.png"
    },
    {
      "src": "/favicon-192.png",
      "dest": "/favicon-192.png"
    },
    {
      "src": "/favicon-512.png",
      "dest": "/favicon-512.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "src": "/og.svg",
      "dest": "/og.svg"
    },
    {
      "src": "/og.png",
      "dest": "/og.png"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/sentence-rewriter",
      "dest": "/sentence-rewriter.html"
    },
    {
      "src": "/paraphrase-essay",
      "dest": "/paraphrase-essay.html"
    },
    {
      "src": "/how-to-paraphrase",
      "dest": "/how-to-paraphrase.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
