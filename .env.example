# RewordAI configuration
# Local: copy this file to .env.
# Vercel: set these in Project Settings > Environment Variables.

# Your own LLM API key (required)
USER_LLM_API_KEY=your-api-key-here

# OpenAI-compatible API base URL
USER_LLM_BASE_URL=https://api.deepseek.com/v1

# Model to use for paraphrasing
USER_LLM_MODEL=deepseek-chat

# Port the local server listens on
PORT=3000
